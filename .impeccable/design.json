	"components": [
		{
			"name": "Ink Button",
			"kind": "button",
			"refersTo": "button-ink",
			"description": "The always-reachable Resume action in the header.",
			"html": "<a class=\"ds-btn-ink\" href=\"#\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 4v11M6.5 10 12 15.5 17.5 10M5 20h14\"/></svg>Resume</a>",
			"css": ":host{--ink:#15171c;--ink-2:#43474f;--ink-3:#61656f;--paper:#fff;--ground:#f4f5f7;--ground-deep:#e9ecf0;--line:#e1e4e9;--line-strong:#c7cbd3;--lime:#d4f25a;--lime-deep:#4f6b00;--lime-wash:#f2fbd2;font-family:'Mona Sans',ui-sans-serif,system-ui,sans-serif}.ds-btn-ink{display:inline-flex;align-items:center;gap:8px;height:44px;padding:0 18px;border-radius:999px;background:var(--ink);color:var(--paper);font-weight:650;font-size:15px;text-decoration:none;transition:color .2s cubic-bezier(0.16, 1, 0.3, 1)}.ds-btn-ink:hover{color:var(--lime)}.ds-btn-ink:focus-visible{outline:2.5px solid var(--ink);outline-offset:3px}"
		},
		{
			"name": "Role Chip",
			"kind": "chip",
			"refersTo": "chip",
			"description": "\"I'm hiring for\" and catalogue filters; lime when picked, with a count.",
			"html": "<button class=\"ds-chip\" aria-pressed=\"false\">Back-end <span class=\"ds-chip-count\">13</span></button><button class=\"ds-chip\" aria-pressed=\"true\">AI <span class=\"ds-chip-count\">14</span></button>",
			"css": ":host{--ink:#15171c;--ink-2:#43474f;--ink-3:#61656f;--paper:#fff;--ground:#f4f5f7;--ground-deep:#e9ecf0;--line:#e1e4e9;--line-strong:#c7cbd3;--lime:#d4f25a;--lime-deep:#4f6b00;--lime-wash:#f2fbd2;font-family:'Mona Sans',ui-sans-serif,system-ui,sans-serif}.ds-chip{display:inline-flex;align-items:center;gap:6px;height:40px;padding:0 16px;margin:4px;border:1px solid var(--line-strong);border-radius:999px;background:var(--paper);color:var(--ink);font-family:inherit;font-size:15px;font-weight:620;line-height:1;cursor:pointer;transition:background-color .18s cubic-bezier(0.16, 1, 0.3, 1),border-color .18s}.ds-chip:hover{border-color:var(--ink)}.ds-chip[aria-pressed=true]{background:var(--lime);border-color:var(--ink)}.ds-chip-count{min-width:1.8em;padding:1px 7px;border-radius:999px;background:var(--ground);color:var(--ink-3);font-size:13px;font-weight:650;text-align:center}.ds-chip[aria-pressed=true] .ds-chip-count{background:rgba(21,23,28,.1);color:var(--ink)}.ds-chip:focus-visible{outline:2.5px solid var(--ink);outline-offset:3px}"
		},
		{
			"name": "Prompt Bar",
			"kind": "input",
			"refersTo": "prompt-bar",
			"description": "The signature input: paste a job posting or ask; voice and a lime send key.",
			"html": "<form class=\"ds-bar\"><textarea class=\"ds-bar-input\" rows=\"1\" placeholder=\"Paste a job posting, see why Anass fits.\"></textarea><div class=\"ds-bar-tools\"><p class=\"ds-bar-hint\">Ask anything about his work.</p><button type=\"button\" class=\"ds-bar-mic\" aria-label=\"Ask by voice\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"><rect x=\"9\" y=\"3\" width=\"6\" height=\"11\" rx=\"3\"/><path d=\"M5.5 11a6.5 6.5 0 0 0 13 0M12 17.5V21\"/></svg></button><button class=\"ds-bar-send\" aria-label=\"Ask\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 19V5M5.5 11.5 12 5l6.5 6.5\"/></svg></button></div></form>",
			"css": ":host{--ink:#15171c;--ink-2:#43474f;--ink-3:#61656f;--paper:#fff;--ground:#f4f5f7;--ground-deep:#e9ecf0;--line:#e1e4e9;--line-strong:#c7cbd3;--lime:#d4f25a;--lime-deep:#4f6b00;--lime-wash:#f2fbd2;font-family:'Mona Sans',ui-sans-serif,system-ui,sans-serif}.ds-bar{max-width:560px;border-radius:20px;background:var(--paper);box-shadow:0 1px 2px rgba(21,23,28,.08),0 14px 40px -16px rgba(21,23,28,.28)}.ds-bar:focus-within{box-shadow:0 0 0 2px var(--ink),0 18px 48px -18px rgba(21,23,28,.34)}.ds-bar-input{display:block;width:100%;box-sizing:border-box;min-height:64px;padding:20px 22px 4px;border:0;background:transparent;font-family:inherit;font-size:17px;line-height:1.5;color:var(--ink);resize:none;outline:none}.ds-bar-input::placeholder{color:var(--ink-3)}.ds-bar-tools{display:flex;align-items:center;gap:6px;padding:6px 10px 10px 22px}.ds-bar-hint{flex:1;margin:0;color:var(--ink-3);font-size:13px}.ds-bar-mic,.ds-bar-send{display:grid;place-items:center;width:40px;height:40px;border:0;border-radius:999px;cursor:pointer}.ds-bar-mic{background:transparent;color:var(--ink);box-shadow:inset 0 0 0 1px var(--line-strong)}.ds-bar-send{background:var(--lime);color:var(--ink);box-shadow:inset 0 0 0 1.5px var(--ink);transition:background-color .2s,color .2s}.ds-bar-send:hover{background:var(--ink);color:var(--lime)}"
		},
		{
			"name": "Work Tile",
			"kind": "card",
			"refersTo": "tile",
			"description": "One piece of work: square code-drawn art, title, one line with its number, stack, meta.",
			"html": "<a class=\"ds-tile\" href=\"#\"><span class=\"ds-tile-art\"><span class=\"ds-tile-mark\">Back-end · gRPC</span></span><span class=\"ds-tile-body\"><span class=\"ds-tile-title\">Shopify Infrastructure Security</span><span class=\"ds-tile-line\">Cut internal request latency 10x by moving services from HTTP/1 to gRPC.</span><span class=\"ds-tile-stack\">gRPC · Google Cloud · C++</span><span class=\"ds-tile-meta\">Internship · 2025</span></span></a>",
			"css": ":host{--ink:#15171c;--ink-2:#43474f;--ink-3:#61656f;--paper:#fff;--ground:#f4f5f7;--ground-deep:#e9ecf0;--line:#e1e4e9;--line-strong:#c7cbd3;--lime:#d4f25a;--lime-deep:#4f6b00;--lime-wash:#f2fbd2;font-family:'Mona Sans',ui-sans-serif,system-ui,sans-serif}.ds-tile{display:flex;flex-direction:column;width:260px;overflow:hidden;border-radius:16px;background:var(--ground);color:var(--ink);text-decoration:none;transition:transform .3s cubic-bezier(0.16, 1, 0.3, 1),box-shadow .3s cubic-bezier(0.16, 1, 0.3, 1)}.ds-tile:hover{transform:translateY(-4px);box-shadow:0 22px 44px -26px rgba(21,23,28,.45)}.ds-tile:focus-visible{outline:2.5px solid var(--ink);outline-offset:3px}.ds-tile-art{position:relative;display:block;aspect-ratio:1;background:var(--ground-deep)}.ds-tile-mark{position:absolute;left:10px;top:10px;padding:5px 11px;border-radius:999px;background:var(--lime);box-shadow:inset 0 0 0 1.5px var(--ink);font-size:12px;font-weight:720}.ds-tile-body{display:flex;flex-direction:column;gap:6px;padding:16px 18px 18px}.ds-tile-title{font-size:17px;font-weight:720;line-height:1.25}.ds-tile-line{color:var(--ink-2);font-size:15px;line-height:1.45}.ds-tile-stack{padding-top:8px;font-size:13px;font-weight:620}.ds-tile-meta{color:var(--ink-3);font-size:13px}"
		},
		{
			"name": "Technology Search",
			"kind": "input",
			"refersTo": "search-input",
			"description": "Filters the catalogue by technology, with suggestions from the tag list.",
			"html": "<label class=\"ds-search\"><svg viewBox=\"0 0 24 24\" width=\"18\" height=\"18\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\"><circle cx=\"11\" cy=\"11\" r=\"6.5\"/><path d=\"m16 16 4 4\"/></svg><input type=\"search\" placeholder=\"Search tech: Python, gRPC, RAG…\"></label>",
			"css": ":host{--ink:#15171c;--ink-2:#43474f;--ink-3:#61656f;--paper:#fff;--ground:#f4f5f7;--ground-deep:#e9ecf0;--line:#e1e4e9;--line-strong:#c7cbd3;--lime:#d4f25a;--lime-deep:#4f6b00;--lime-wash:#f2fbd2;font-family:'Mona Sans',ui-sans-serif,system-ui,sans-serif}.ds-search{position:relative;display:block;width:340px}.ds-search svg{position:absolute;left:14px;top:13px;color:var(--ink-3)}.ds-search input{width:100%;box-sizing:border-box;height:44px;padding:0 16px 0 42px;border:1px solid var(--line-strong);border-radius:999px;background:var(--ground);font-family:inherit;font-size:15px;color:var(--ink)}.ds-search input:hover{border-color:var(--ink-3)}.ds-search input:focus{outline:none;background:var(--paper);border-color:var(--ink);box-shadow:0 0 0 1.5px var(--ink)}"
